{
  "name": "flowmap",
  "private": true,
  "version": "0.1.0",
  "description": "Map how a process actually works \u2014 steps, owners, durations, and the loops where it doubles back.",
  "license": "MIT",
  "author": "Francisco Apraiz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Iffrit-coder/flowmap.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"tsx watch scripts/dev-api-server.ts\"",
    "build": "node scripts/check-esm-imports.mjs && node scripts/check-function-count.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:esm": "node scripts/check-esm-imports.mjs",
    "check:functions": "node scripts/check-function-count.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@xyflow/react": "^12.11.2",
    "nanoid": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "dotenv": "^17.0.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
